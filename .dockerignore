# Repo-root .dockerignore — governs the backend image build whose context is the repo root
# (see backend/Dockerfile). Only backend/, connectors/ and help-corpus/ are needed; exclude
# everything else so the build context stays small. help-corpus/ is the pre-generated help
# documentation bundle, so website/ and docs/ stay excluded even though it is derived from them.
.git/
.github/
.idea/
.vscode/
*.iml

# Other areas not needed by the backend image
frontend/
e2e/
website/
docs/
charts/
deploy/
docker-compose*.yml

# Build output and caches
**/target/
**/node_modules/
*.log

# Backend bits not needed in the image
backend/.mvn/wrapper/maven-wrapper.jar
backend/docker-compose-dev.yml
backend/Dockerfile
backend/.dockerignore
